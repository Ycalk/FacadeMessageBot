# Development mode (true - не отправлять реальные запросы в Moder Service)
DEVELOP=true

# Max Bot
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_URL=https://maxbot.bnw-tech.ru
BOT_WEBHOOK_SECRET=your_webhook_secret_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password

# Elasticsearch
ELASTIC_PASSWORD=change_me_elastic_password

# Moder Service
MODER_SERVICE_URL=http://moder:8001

# External moderator service (внешняя модерация)
EXTERNAL_MODERATOR_URL=

# Cities Service
CITIES_SERVICE_URL=http://cities:8080
CITIES_API_TOKEN=change_me_cities_token
CITIES_FILE_PATH=/home/cities/app/data/cities.csv

# Webhook server для приёма хуков от Moder Service
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# Name validation
NAME_API_KEY=your_name_api_key
NAME_API_URL=https://api.nameapi.org/rest/v5.3/parser/personnameparser
NAME_FILE_PATH=/home/app/data/names.csv
MINIMAL_NAME_CONFIDENCE=0.6

# PostgreSQL
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpass
POSTGRES_DB=botdb

# Database
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Bot settings
MAX_MESSAGE_LENGTH=80
MAX_NAME_LENGTH=15
MAXIMUM_MESSAGES_PER_USER=2
MESSAGES_TIME_OUT_MINUTES=1
UNLIMITED_USERS=123456,789012

# Антиспам
ANTISPAM_MAX_ACTIONS=5
ANTISPAM_WINDOW_SECONDS=10
ANTISPAM_BLOCK_SECONDS=30

# Модераторы (список через запятую)
MODERATORS=moderator_1,moderator_2
VK_MODERATORS=vk_moderator_1,vk_moderator_2,vk_moderator_3

# Автомодерация через Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
AUTO_MODERATION_STUCK_TIMEOUT_MINUTES=5

# Токен для авторизации входящих запросов к API (Bearer)
API_TOKEN=your_api_token_here

# Maer API (внешняя модерация)
MAER_API_URL=https://maer-api.example.com
MAER_API_TOKEN=your_maer_token_here

# Ссылка на условия пользования (отображается на стартовом экране)
TERMS_OF_USE_URL=https://example.com/terms


# Путь к папке с фонами и генерируемыми превью
DATA_DIR=/home/app/data
